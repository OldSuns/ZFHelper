<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_lesson_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/schedule_widget_lesson_background"
    android:forceDarkAllowed="false"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingBottom="5dp"
    android:paddingHorizontal="@dimen/schedule_widget_padding"
    android:paddingTop="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="1dp"
        android:paddingTop="1dp">

        <LinearLayout
            android:id="@+id/schedule_widget_lesson_time"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/schedule_widget_lesson_start"
                android:textColor="@color/widget_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/schedule_widget_body_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/schedule_widget_lesson_end"
                android:textColor="@color/widget_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/schedule_widget_body_text" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/schedule_widget_lesson_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@color/widget_primary"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_widget_lesson_state"
                android:textColor="@color/widget_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/schedule_widget_caption_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/schedule_widget_lesson_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/schedule_widget_lesson_title"
                    android:textColor="@color/widget_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textSize="@dimen/schedule_widget_row_title_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/schedule_widget_lesson_countdown"
                    android:textColor="@color/widget_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/schedule_widget_countdown_gap"
                    android:background="@drawable/schedule_widget_countdown_background"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/schedule_widget_countdown_padding"
                    android:paddingVertical="2dp"
                    android:textSize="@dimen/schedule_widget_caption_text"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/schedule_widget_lesson_when"
                android:textColor="@color/widget_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_body_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/schedule_widget_lesson_location"
                android:textColor="@color/widget_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_body_text" />

            <TextView
                android:id="@+id/schedule_widget_lesson_detail"
                android:textColor="@color/widget_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_caption_text" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
