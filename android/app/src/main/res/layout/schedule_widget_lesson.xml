<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_lesson_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="48dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:paddingTop="6dp">

        <LinearLayout
            android:id="@+id/schedule_widget_lesson_time"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/schedule_widget_lesson_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/schedule_widget_body_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/schedule_widget_lesson_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/schedule_widget_body_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_widget_lesson_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_row_title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/schedule_widget_lesson_when"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_body_text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/schedule_widget_lesson_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_body_text" />

            <TextView
                android:id="@+id/schedule_widget_lesson_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textSize="@dimen/schedule_widget_caption_text" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/schedule_widget_lesson_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />
</LinearLayout>
