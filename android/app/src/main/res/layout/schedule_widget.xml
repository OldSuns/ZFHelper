<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/schedule_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/schedule_widget_padding">

    <LinearLayout
        android:id="@+id/schedule_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/schedule_widget_name"
                android:textSize="@dimen/schedule_widget_body_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/schedule_widget_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:text="@string/schedule_widget_today"
                android:textSize="@dimen/schedule_widget_caption_text" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/schedule_widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schedule_widget_refresh"
            android:padding="13dp"
            android:src="@drawable/schedule_widget_refresh" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_widget_focus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/schedule_widget_focus_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/schedule_widget_focus"
            android:textSize="@dimen/schedule_widget_caption_text" />

        <TextView
            android:id="@+id/schedule_widget_focus_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/schedule_widget_start"
            android:textSize="@dimen/schedule_widget_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/schedule_widget_focus_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="@dimen/schedule_widget_body_text" />

        <TextView
            android:id="@+id/schedule_widget_focus_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="@dimen/schedule_widget_body_text"
            android:visibility="gone" />
    </LinearLayout>

    <ListView
        android:id="@+id/schedule_widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@null"
        android:scrollbars="vertical"
        android:visibility="gone" />
</LinearLayout>
